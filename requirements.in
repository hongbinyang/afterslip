torchvision==0.19.1
hydra-core==1.3.2
omegaconf==2.3.0
einops==0.8.0

# Upstream reference code: ReinFlow (third_party/ReinFlow, pinned submodule), installed
# with --no-deps by `make install`. Only the packages its Robomimic/flow code imports are
# listed, at upstream's pins (its pyproject.toml); its extras (d4rl -> mujoco-py) are not
# installed. Deviations from upstream are recorded in docs/setup.md §2.2.
wandb==0.17.7           # imported at module level by the training agents; logging stays off
gdown==5.2.0            # imported by upstream's run script for downloads
tqdm==4.66.5
matplotlib==3.7.5

