# Direct Python dependencies (docs/setup.md §2, §4), compiled to the per-platform pip locks
# by `make lock`. Every locked package is listed in ARTIFACTS.md Appendix A.

# Simulation stack
robosuite==1.4.1
# robomimic v0.4.0, pinned by commit (not published on PyPI). 0.3.0 from PyPI imports the
# old mujoco_py unconditionally; v0.4.0 guards that import, so robosuite 1.4.1 runs on the
# official mujoco bindings. Upstream ReinFlow installs robomimic from unpinned git HEAD.
# It declares egl-probe, which does not build on macOS; requirements-overrides.txt limits
# that to Linux.
robomimic @ git+https://github.com/ARISE-Initiative/robomimic.git@7c66e7a41b5d9dcc905b1a68346bfee1b49b79c9
gym==0.22.0
mujoco                  # resolved by robosuite; 3.2.3 observed on macOS + Python 3.8

